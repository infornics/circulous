    QApplication, QWidget, QHBoxLayout, QVBoxLayout, QPushButton,
    QLabel, QLineEdit, QScrollArea, QDialog
)
from PyQt6.QtGui import QFont, QCursor

# Try importing psutil for CPU/RAM system metrics
try:
    import psutil
    HAS_PSUTIL = True
except ImportError:
    HAS_PSUTIL = False


# QSS Stylesheet for Circulous Dark Glassmorphism Theme
