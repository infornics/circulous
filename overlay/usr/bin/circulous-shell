APPS_LIST = [
    {"name": "🖥️ Terminal", "cmd": "qterminal", "desc": "Circulous Terminal"},
    {"name": "📁 File Manager", "cmd": "pcmanfm-qt", "desc": "Browse Files"},
    {"name": "📝 Text Editor", "cmd": "featherpad", "desc": "FeatherPad Editor"},
    {"name": "💿 Install Circulous", "cmd": "sudo calamares", "desc": "System Installer"},
    {"name": "⚙️ Openbox Config", "cmd": "obconf-qt", "desc": "Window Manager Settings"},
    {"name": "💾 Disk Manager", "cmd": "gparted", "desc": "GParted Partition Editor"},
    {"name": "📊 Task Manager", "cmd": "qterminal -e htop", "desc": "System Process Monitor"},
]


class CirculousLauncher(QWidget):
    """Application Launcher Start Menu Window"""
    def __init__(self, parent=None):
        super().__init__(parent, Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint | Qt.WindowType.Tool)
        self.setObjectName("LauncherWindow")
        self.resize(400, 450)
        self.init_ui()

    def init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(10)

        # Header
        header = QLabel("🌀 Circulous Launcher")
        header.setFont(QFont("Ubuntu", 14, QFont.Weight.Bold))
        header.setStyleSheet("color: #00e5ff; margin-bottom: 2px;")
        layout.addWidget(header)

        # Search Bar
        self.search_box = QLineEdit()
        self.search_box.setObjectName("SearchBox")
        self.search_box.setPlaceholderText("Type to search apps...")
        self.search_box.textChanged.connect(self.filter_apps)
        layout.addWidget(self.search_box)

        # Scroll Area for Apps
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setStyleSheet("background: transparent; border: none;")

        self.scroll_content = QWidget()
        self.scroll_layout = QVBoxLayout(self.scroll_content)
        self.scroll_layout.setSpacing(6)
        self.scroll_layout.setContentsMargins(0, 0, 0, 0)

        self.app_buttons = []
        for app in APPS_LIST:
            btn = QPushButton(f"{app['name']}\n  {app['desc']}")
            btn.setObjectName("AppGridBtn")
            btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
            btn.clicked.connect(lambda _, cmd=app['cmd']: self.launch_app(cmd))
            self.scroll_layout.addWidget(btn)
            self.app_buttons.append((app, btn))

        self.scroll_layout.addStretch()
        scroll.setWidget(self.scroll_content)
        layout.addWidget(scroll)

    def filter_apps(self, text):
        query = text.lower().strip()
        for app, btn in self.app_buttons:
            if query in app['name'].lower() or query in app['desc'].lower():
                btn.show()
            else:
                btn.hide()

    def launch_app(self, cmd):
        self.hide()
        try:
            subprocess.Popen(cmd.split())
        except Exception as e:
            print(f"Error launching {cmd}: {e}")


class PowerDialog(QDialog):
    """System Power Options Dialog"""
    def __init__(self, parent=None):
        super().__init__(parent, Qt.WindowType.FramelessWindowHint)
        self.setStyleSheet("background-color: #0e131f; border: 2px solid #ff355e; border-radius: 12px; padding: 16px;")
        layout = QVBoxLayout(self)

        title = QLabel("🌀 Session Options")
        title.setFont(QFont("Ubuntu", 14, QFont.Weight.Bold))
        title.setStyleSheet("color: #ff355e; margin-bottom: 10px;")
        layout.addWidget(title)

        reboot_btn = QPushButton("🔄 Restart System")
        reboot_btn.setStyleSheet("background: rgba(0,229,255,0.2); border: 1px solid #00e5ff; color: #fff; padding: 10px; border-radius: 8px;")
        reboot_btn.clicked.connect(lambda: subprocess.Popen(["systemctl", "reboot"]))
        layout.addWidget(reboot_btn)

        poweroff_btn = QPushButton("⏻ Shut Down")
        poweroff_btn.setStyleSheet("background: rgba(255,53,94,0.3); border: 1px solid #ff355e; color: #fff; padding: 10px; border-radius: 8px;")
        poweroff_btn.clicked.connect(lambda: subprocess.Popen(["systemctl", "poweroff"]))
        layout.addWidget(poweroff_btn)

        cancel_btn = QPushButton("❌ Cancel")
        cancel_btn.setStyleSheet("background: rgba(255,255,255,0.1); color: #ccc; padding: 8px; border-radius: 8px;")
        cancel_btn.clicked.connect(self.close)
        layout.addWidget(cancel_btn)


class CirculousPanel(QWidget):
    """Main Desktop Top Bar Panel"""
    def __init__(self):
        super().__init__()
        self.setObjectName("TopPanel")
        
        # Configure X11 Panel Window Flags
        self.setWindowFlags(
            Qt.WindowType.FramelessWindowHint |
            Qt.WindowType.WindowStaysOnTopHint
        )
        
        screen_geo = QApplication.primaryScreen().geometry()
        self.setGeometry(0, 0, screen_geo.width(), 44)
        
        self.launcher = CirculousLauncher()
        self.init_ui()

        # Update Timer for Clock & Metrics
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_metrics)
        self.timer.start(1000)
        self.update_metrics()

    def init_ui(self):
        layout = QHBoxLayout(self)
        layout.setContentsMargins(8, 2, 8, 2)
        layout.setSpacing(10)

        # Left Section: Circulous Menu Button
        self.menu_btn = QPushButton("🌀 Circulous")
        self.menu_btn.setObjectName("CirculousMenuBtn")
        self.menu_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        self.menu_btn.clicked.connect(self.toggle_launcher)
        layout.addWidget(self.menu_btn)

        # Active Session Title
        self.title_lbl = QLabel("Circulous 1.0 (Live Session)")
        self.title_lbl.setStyleSheet("color: #00e5ff; font-weight: bold; font-size: 13px;")
        layout.addWidget(self.title_lbl)

        layout.addStretch()

        # Right Section: Metrics & Clock & Power
        self.cpu_lbl = QLabel("🧠 CPU: --%")
        self.cpu_lbl.setObjectName("StatusPill")
        layout.addWidget(self.cpu_lbl)

        self.ram_lbl = QLabel("💾 RAM: --%")
        self.ram_lbl.setObjectName("StatusPill")
        layout.addWidget(self.ram_lbl)

        self.clock_lbl = QLabel("🕒 --:--")
        self.clock_lbl.setObjectName("ClockPill")
        layout.addWidget(self.clock_lbl)

        self.power_btn = QPushButton("⏻")
        self.power_btn.setObjectName("PowerBtn")
        self.power_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        self.power_btn.clicked.connect(self.show_power_dialog)
        layout.addWidget(self.power_btn)

    def update_metrics(self):
        # Update Date & Clock
        now = QTime.currentTime().toString("hh:mm:ss")
        date_str = QDate.currentDate().toString("ddd, d MMM")
        self.clock_lbl.setText(f"🕒 {date_str} {now}")

        # Update CPU & RAM metrics
        if HAS_PSUTIL:
            cpu = psutil.cpu_percent()
            ram = psutil.virtual_memory().percent
            self.cpu_lbl.setText(f"🧠 CPU: {cpu:.0f}%")
            self.ram_lbl.setText(f"💾 RAM: {ram:.0f}%")

    def toggle_launcher(self):
        if self.launcher.isVisible():
            self.launcher.hide()
        else:
            btn_pos = self.menu_btn.mapToGlobal(self.menu_btn.rect().bottomLeft())
            self.launcher.move(btn_pos.x(), btn_pos.y() + 6)
            self.launcher.show()
            self.launcher.activateWindow()

    def show_power_dialog(self):
        dialog = PowerDialog(self)
        dialog.exec()


def main():
    app = QApplication(sys.argv)
    app.setStyleSheet(CIRCULOUS_QSS)
    panel = CirculousPanel()
    panel.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
