    QLabel, QLineEdit, QScrollArea, QDialog, QGridLayout, QFrame,
    QMenu, QGraphicsDropShadowEffect
)
from PyQt6.QtGui import QFont, QCursor, QColor, QIcon, QAction

# Try importing psutil for CPU/RAM system metrics
try:
    import psutil
    HAS_PSUTIL = True
except ImportError:
    HAS_PSUTIL = False


