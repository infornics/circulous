class AboutDialog(QDialog):
    """macOS-inspired About Circulous Information Panel"""
    def __init__(self, parent=None):
        super().__init__(parent, Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint)
        self.setObjectName("ModalDialog")
        self.setFixedSize(380, 280)
        self.init_ui()

    def init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(10)

        logo = QLabel("🌀")
        logo.setFont(QFont("Ubuntu", 42))
        logo.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(logo)

        title = QLabel("Circulous Distribution")
        title.setFont(QFont("Ubuntu", 16, QFont.Weight.Bold))
        title.setStyleSheet("color: #00e5ff;")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        version = QLabel("Version 1.0 Resolute (26.04 LTS)\nBuilt on Linux Kernel & Openbox Engine")
        version.setFont(QFont("Ubuntu", 10))
        version.setStyleSheet("color: #8b949e;")
        version.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(version)

        info = QLabel("Circulous Native Desktop Shell (PyQt6)\n© 2026 Infornics Circulous Project")
        info.setFont(QFont("Ubuntu", 9))
        info.setStyleSheet("color: #6e7681; margin-top: 6px;")
        info.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(info)

        close_btn = QPushButton("Close")
        close_btn.setStyleSheet("background: #00e5ff; color: #000; font-weight: bold; border-radius: 6px; padding: 6px;")
        close_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        close_btn.clicked.connect(self.close)
        layout.addWidget(close_btn)


class PowerDialog(QDialog):
    """System Session Power & Shutdown Dialog"""
    def __init__(self, parent=None):
        super().__init__(parent, Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint)
        self.setObjectName("ModalDialog")
        self.setStyleSheet("background-color: #0e131f; border: 2px solid #ff355e; border-radius: 14px; padding: 10px;")
        self.setFixedSize(320, 220)
        self.init_ui()

    def init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(15, 15, 15, 15)
        layout.setSpacing(8)

        title = QLabel("🌀 Session Options")
        title.setFont(QFont("Ubuntu", 14, QFont.Weight.Bold))
        title.setStyleSheet("color: #ff355e;")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        reboot_btn = QPushButton("🔄 Restart System")
        reboot_btn.setStyleSheet("background: rgba(0,229,255,0.2); border: 1px solid #00e5ff; color: #fff; padding: 8px; border-radius: 8px; font-weight: bold;")
        reboot_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        reboot_btn.clicked.connect(lambda: subprocess.Popen(["systemctl", "reboot"]))
        layout.addWidget(reboot_btn)

        poweroff_btn = QPushButton("⏻ Shut Down")
        poweroff_btn.setStyleSheet("background: rgba(255,53,94,0.3); border: 1px solid #ff355e; color: #fff; padding: 8px; border-radius: 8px; font-weight: bold;")
        poweroff_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        poweroff_btn.clicked.connect(lambda: subprocess.Popen(["systemctl", "poweroff"]))
        layout.addWidget(poweroff_btn)

        cancel_btn = QPushButton("Cancel")
        cancel_btn.setStyleSheet("background: rgba(255,255,255,0.1); color: #ccc; padding: 6px; border-radius: 6px;")
        cancel_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        cancel_btn.clicked.connect(self.close)
        layout.addWidget(cancel_btn)


class CirculousLaunchpad(QWidget):
    """Full-Screen macOS Launchpad Overlay Grid"""
    def __init__(self, launcher_callback, parent=None):
        super().__init__(parent, Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint | Qt.WindowType.Tool)
        self.setObjectName("LaunchpadOverlay")
        self.launcher_callback = launcher_callback
        
        screen = QApplication.primaryScreen().geometry()
        self.setGeometry(0, 0, screen.width(), screen.height())
        self.init_ui()

    def init_ui(self):
        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(60, 40, 60, 40)
        main_layout.setSpacing(20)

        # Top Header & Search Bar
        header_layout = QHBoxLayout()
        header_layout.addStretch()

        self.search_box = QLineEdit()
        self.search_box.setObjectName("LaunchpadSearch")
        self.search_box.setPlaceholderText("🔍 Search Applications in Circulous...")
        self.search_box.setFixedWidth(400)
        self.search_box.textChanged.connect(self.filter_apps)
        header_layout.addWidget(self.search_box)

        header_layout.addStretch()
        main_layout.addLayout(header_layout)

        # App Grid Scroll Container
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setStyleSheet("background: transparent; border: none;")

        grid_widget = QWidget()
        grid_widget.setStyleSheet("background: transparent;")
        self.grid_layout = QGridLayout(grid_widget)
        self.grid_layout.setSpacing(20)

        all_apps = DOCK_APPS + LAUNCHPAD_EXTRA_APPS
        self.app_tiles = []

        cols = 4
        for idx, app in enumerate(all_apps):
            if app["cmd"] == "LAUNCHPAD_TOGGLE":
                continue

            row = idx // cols
            col = idx % cols

            tile = QPushButton()
            tile.setObjectName("AppTile")
            tile.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
            tile.setFixedSize(220, 120)

            tile_layout = QVBoxLayout(tile)
            tile_layout.setContentsMargins(10, 10, 10, 10)
            tile_layout.setSpacing(4)

            icon_lbl = QLabel(app["icon"])
            icon_lbl.setFont(QFont("Ubuntu", 28))
            icon_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)

            name_lbl = QLabel(app["name"])
            name_lbl.setFont(QFont("Ubuntu", 12, QFont.Weight.Bold))
            name_lbl.setStyleSheet("color: #00e5ff;")
            name_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)

            desc_lbl = QLabel(app["desc"])
            desc_lbl.setFont(QFont("Ubuntu", 9))
            desc_lbl.setStyleSheet("color: #8b949e;")
            desc_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)

            tile_layout.addWidget(icon_lbl)
            tile_layout.addWidget(name_lbl)
            tile_layout.addWidget(desc_lbl)

            tile.clicked.connect(lambda _, cmd=app["cmd"]: self.on_app_clicked(cmd))
            self.grid_layout.addWidget(tile, row, col)
            self.app_tiles.append((app, tile))

        scroll.setWidget(grid_widget)
        main_layout.addWidget(scroll)

        # ESC instructions label
        esc_lbl = QLabel("Press ESC or click anywhere to exit Launchpad")
        esc_lbl.setFont(QFont("Ubuntu", 10))
        esc_lbl.setStyleSheet("color: #6e7681; margin-top: 10px;")
        esc_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        main_layout.addWidget(esc_lbl)

    def filter_apps(self, text):
        query = text.lower().strip()
        for app, tile in self.app_tiles:
            if query in app["name"].lower() or query in app["desc"].lower() or query in app["category"].lower():
                tile.show()
            else:
                tile.hide()

    def on_app_clicked(self, cmd):
        self.hide()
        self.launcher_callback(cmd)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key.Key_Escape:
            self.hide()
        else:
            super().keyPressEvent(event)

    def mousePressEvent(self, event):
        # Click outside tiles closes launchpad
        self.hide()


class CirculousDock(QWidget):
    """Floating macOS-inspired Bottom Dock Window"""
    def __init__(self, launchpad_toggle_cb, app_launch_cb, parent=None):
        super().__init__(parent, Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint | Qt.WindowType.Tool)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.launchpad_toggle_cb = launchpad_toggle_cb
        self.app_launch_cb = app_launch_cb

        self.init_ui()
        self.position_dock()

    def position_dock(self):
        screen = QApplication.primaryScreen().geometry()
        dock_width = len(DOCK_APPS) * 58 + 24
        dock_height = 68
        x = (screen.width() - dock_width) // 2
        y = screen.height() - dock_height - 10
        self.setGeometry(x, y, dock_width, dock_height)

    def init_ui(self):
        main_layout = QHBoxLayout(self)
        main_layout.setContentsMargins(0, 0, 0, 0)

        # Glass Capsule Frame
        frame = QFrame()
        frame.setObjectName("DockContainer")
        frame_layout = QHBoxLayout(frame)
        frame_layout.setContentsMargins(10, 6, 10, 6)
        frame_layout.setSpacing(8)

        for app in DOCK_APPS:
            btn_wrapper = QWidget()
            wrapper_layout = QVBoxLayout(btn_wrapper)
            wrapper_layout.setContentsMargins(0, 0, 0, 0)
            wrapper_layout.setSpacing(2)

            btn = QPushButton(app["icon"])
            btn.setProperty("class", "DockIconBtn")
            btn.setFixedSize(48, 48)
            btn.setToolTip(f"{app['name']} - {app['desc']}")
            btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))

            if app["cmd"] == "LAUNCHPAD_TOGGLE":
                btn.clicked.connect(self.launchpad_toggle_cb)
            else:
                btn.clicked.connect(lambda _, cmd=app["cmd"]: self.app_launch_cb(cmd))

            # Active indicator dot
            dot = QLabel("•" if app["cmd"] != "LAUNCHPAD_TOGGLE" else "")
            dot.setFont(QFont("Ubuntu", 12, QFont.Weight.Bold))
            dot.setStyleSheet("color: rgba(0, 229, 255, 0.6); margin-top: -4px;")
            dot.setAlignment(Qt.AlignmentFlag.AlignCenter)

            wrapper_layout.addWidget(btn)
            wrapper_layout.addWidget(dot)
            frame_layout.addWidget(btn_wrapper)

        main_layout.addWidget(frame)


class CirculousTopBar(QWidget):
    """macOS-inspired Top Status Bar Panel"""
    def __init__(self, launchpad_toggle_cb, parent=None):
        super().__init__(parent, Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint | Qt.WindowType.Tool)
        self.setObjectName("TopBar")
        self.launchpad_toggle_cb = launchpad_toggle_cb
        
        self.screen = QApplication.primaryScreen()
        screen_geo = self.screen.geometry()
        self.setGeometry(0, 0, screen_geo.width(), 32)
        
        self.screen.geometryChanged.connect(self.on_screen_resized)
        self.init_ui()

        # Timer for Clock & Resource Metrics
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_metrics)
        self.timer.start(1000)
        self.update_metrics()

    def on_screen_resized(self, geo):
        self.setGeometry(0, 0, geo.width(), 32)

    def init_ui(self):
        layout = QHBoxLayout(self)
        layout.setContentsMargins(6, 2, 8, 2)
        layout.setSpacing(4)

        # Circulous Menu Button
        self.logo_btn = QPushButton("🌀 Circulous")
        self.logo_btn.setObjectName("LogoBtn")
        self.logo_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        self.logo_btn.clicked.connect(self.show_system_menu)
        layout.addWidget(self.logo_btn)

        # Active App Title
        self.app_title = QLabel("Circulous Desktop")
        self.app_title.setObjectName("AppTitleLbl")
        layout.addWidget(self.app_title)

        # Global Menu Items
        for menu_name in ["File", "Edit", "View", "Window", "Help"]:
            btn = QPushButton(menu_name)
            btn.setProperty("class", "MenuBtn")
            btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
            btn.clicked.connect(lambda _, m=menu_name: self.on_menu_clicked(m))
            layout.addWidget(btn)

        layout.addStretch()

        # Status Pills
        self.cpu_lbl = QLabel("CPU: --%")
        self.cpu_lbl.setObjectName("StatusPill")
        layout.addWidget(self.cpu_lbl)

        self.ram_lbl = QLabel("RAM: --%")
        self.ram_lbl.setObjectName("StatusPill")
        layout.addWidget(self.ram_lbl)

        self.net_lbl = QLabel("📶 Online")
        self.net_lbl.setObjectName("StatusPill")
        layout.addWidget(self.net_lbl)

        self.clock_lbl = QLabel("--:--")
        self.clock_lbl.setObjectName("ClockPill")
        layout.addWidget(self.clock_lbl)

        self.power_btn = QPushButton("⏻")
        self.power_btn.setObjectName("PowerBtn")
        self.power_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        self.power_btn.clicked.connect(self.show_power_dialog)
        layout.addWidget(self.power_btn)

    def update_metrics(self):
        # Update Date & Clock
        now_str = QDate.currentDate().toString("ddd MMM d") + "  " + QTime.currentTime().toString("hh:mm AM/PM")
        self.clock_lbl.setText(now_str)

        # Update CPU & RAM metrics
        if HAS_PSUTIL:
            cpu = psutil.cpu_percent()
            ram = psutil.virtual_memory().percent
            self.cpu_lbl.setText(f"CPU: {cpu:.0f}%")
            self.ram_lbl.setText(f"RAM: {ram:.0f}%")

    def show_system_menu(self):
        menu = QMenu(self)
        menu.setStyleSheet("background-color: #0e131f; color: #fff; border: 1px solid #00e5ff; border-radius: 6px;")

        about_act = menu.addAction("About Circulous")
        about_act.triggered.connect(self.show_about_dialog)

        launchpad_act = menu.addAction("Launchpad App Grid")
        launchpad_act.triggered.connect(self.launchpad_toggle_cb)

        menu.addSeparator()
        power_act = menu.addAction("Session Options (Shutdown / Reboot)")
        power_act.triggered.connect(self.show_power_dialog)

        btn_pos = self.logo_btn.mapToGlobal(self.logo_btn.rect().bottomLeft())
        menu.exec(btn_pos)

    def on_menu_clicked(self, menu_name):
        print(f"Global menu selected: {menu_name}")

    def show_about_dialog(self):
        dialog = AboutDialog(self)
        dialog.exec()

    def show_power_dialog(self):
        dialog = PowerDialog(self)
        dialog.exec()


class CirculousDesktopShell:
    """Master Desktop Controller Orchestrating TopBar, Dock, and Launchpad"""
    def __init__(self):
        self.launchpad = CirculousLaunchpad(self.launch_app)
        self.topbar = CirculousTopBar(self.toggle_launchpad)
        self.dock = CirculousDock(self.toggle_launchpad, self.launch_app)

    def show(self):
        self.topbar.show()
        self.dock.show()

    def toggle_launchpad(self):
        if self.launchpad.isVisible():
            self.launchpad.hide()
        else:
            self.launchpad.show()
            self.launchpad.activateWindow()

    def launch_app(self, cmd):
        try:
            subprocess.Popen(cmd.split())
        except Exception as e:
            print(f"Error launching {cmd}: {e}")


def main():
    app = QApplication(sys.argv)
    app.setStyleSheet(CIRCULOUS_QSS)

    shell = CirculousDesktopShell()
    shell.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
